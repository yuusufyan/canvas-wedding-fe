# Salin menjadi .env lalu sesuaikan. Semua variabel opsional.

# URL backend NestJS yang dipanggil langsung dari browser (tanpa proxy).
# Origin FE (mis. http://localhost:5173) harus terdaftar di CORS_ORIGIN pada .env backend.
# Tanpa isi: dev memakai http://localhost:3000; build produksi memakai URL relatif (same-origin),
# jadi isi nilai ini saat build produksi. Dibaca browser (masuk bundle), jangan isi secret.
VITE_API_BASE_URL=http://localhost:3000

# Hanya mode dev. Isi true untuk melayani endpoint yang belum ada di backend NestJS
# (register, verify-email, role, user, template, dst.) dengan data contoh dari src/api/mock.
# Saat true, auth (login, refresh, me) juga dijawab mock, bukan backend NestJS.
# Kosongkan untuk memakai backend sungguhan. Dibaca browser, jangan isi secret.
VITE_USE_MOCK_API=
