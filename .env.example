# Salin menjadi .env lalu sesuaikan. Semua variabel opsional.

# URL backend yang dituju proxy dev server Vite untuk path /api.
# Hanya dibaca oleh vite.config.ts (tidak masuk bundle browser).
# Sesuaikan port dengan PORT di .env backend. Default: http://localhost:3000
API_PROXY_TARGET=http://localhost:3000
